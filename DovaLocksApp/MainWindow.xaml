<Window x:Class="DovaInstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Variant Mod Organizer" Width="880" Height="810" MinWidth="720" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#111310" FontFamily="Segoe UI" FontSize="14" Foreground="#F0F1E6" Icon="Resources/Dova.ico">
 <Grid Margin="30" Background="#111310"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,24"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="VARIANT MOD ORGANIZER  /  by Dova" Foreground="#E7CC93" FontSize="12" VerticalAlignment="Center"/><Button Content="Variant Interactive Map" Click="OpenWebsite" FontSize="12" Padding="8,3" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#E7CC93"/></StackPanel><TextBlock Text="Your mods. Ready to play." FontSize="32" FontWeight="Light" Margin="0,6,0,5"/><TextBlock Text="Add your mods, pick how you play, and launch ICARUS." Foreground="#BCAE91"/></StackPanel><Button x:Name="CheckButton" Content="Check for updates" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdates"/></Grid>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
 <Border BorderBrush="#393B33" BorderThickness="1" Background="#1C201A" Padding="20"><StackPanel>
 <Grid><TextBlock Text="YOUR ICARUS" Foreground="#E7CC93" FontSize="12"/><Button x:Name="BrowseButton" Content="Change folder" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderThickness="0" Click="Browse"/></Grid>
 <ComboBox x:Name="Locations" Visibility="Collapsed" Margin="0,12,0,0" SelectionChanged="SelectionChangedLocation"/>
 <TextBlock x:Name="GamePath" Text="Finding your game…" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#BCAE91" FontSize="12"/>
 <Grid HorizontalAlignment="Left" Width="412" Margin="0,16,0,0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="12"/><RowDefinition Height="52"/></Grid.RowDefinitions>
 <Button x:Name="ManageButton" Content="Add / remove mods" Click="ManageMods" Padding="10,5" FontSize="12"/>
 <Button x:Name="OpenFolderButton" Grid.Column="2" Content="Open mods folder" Click="OpenFolder" Padding="10,5" FontSize="12"/>
 <Button x:Name="ModdedButton" Grid.Row="2" Content="Launch modded" Click="LaunchModded" Background="#E7CC93" Foreground="#171A15" FontWeight="SemiBold" Padding="14,10"/>
 <Button x:Name="VanillaButton" Grid.Row="2" Grid.Column="2" Content="Launch vanilla" Click="LaunchVanilla" FontWeight="SemiBold" Padding="14,10"/>
 </Grid>
<TextBlock x:Name="ModeLabel" Text="Vanilla keeps your mods aside. Modded brings them back." TextWrapping="Wrap" FontSize="12" Foreground="#BCAE91" Margin="0,10,0,0"/>
</StackPanel></Border>
 <Border BorderBrush="#393B33" BorderThickness="1" Padding="20" Margin="0,16,0,0"><StackPanel>
 <Grid><TextBlock Text="DOVA LOCKS" FontSize="12" Foreground="#E7CC93"/><TextBlock x:Name="VersionLabel" HorizontalAlignment="Right" Foreground="#E7CC93"/></Grid>
 <TextBlock x:Name="InstalledLabel" Margin="0,10,0,0" Text="Checking installed mod…"/>
 <TextBlock x:Name="PlanText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#BCAE91"/>
 <Expander Header="What's new" Margin="0,16,0,0" Foreground="#E7CC93"><TextBlock x:Name="Notes" Text="Check for updates to see the latest changes." TextWrapping="Wrap" Foreground="#D7CBB4" Margin="0,12,0,0"/></Expander>
 </StackPanel></Border>
 <StackPanel Margin="0,20,0,16"><TextBlock x:Name="StatusTitle" Text="WELCOME BACK" FontSize="12" Foreground="#E7CC93"/><TextBlock x:Name="Status" Text="Checking Dova's latest release…" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#D7CBB4"/><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,12,0,0" Foreground="#E7CC93"/>
 <TextBlock Text="Your server and every player need the same mod version. Close ICARUS before installing or updating." TextWrapping="Wrap" Foreground="#BCAE91" FontSize="12" Margin="0,16,0,0"/>
 <Button Content="DovaOutPut diagnostics" Click="Diagnostics" HorizontalAlignment="Left" Margin="0,12,0,0"/>
 <Button x:Name="SaveToolsButton" Content="Dova Locks save tools" HorizontalAlignment="Left" Click="SaveTools" Margin="0,12,0,0"/><Expander Header="Installing on a dedicated server?" Foreground="#E7CC93" Margin="0,16,0,0"><TextBlock Text="For a remote server, upload Dova-Locks_P.pak to Server folder\Icarus\Content\Paks\mods. Stop the server first, then replace the old file. Your lock saves stay in place." TextWrapping="Wrap" Foreground="#BCAE91" Margin="0,10,0,0"/></Expander>
 </StackPanel></StackPanel></ScrollViewer>
 <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="Replaced files are backed up automatically." FontSize="12" Foreground="#BCAE91" VerticalAlignment="Center"/><Button x:Name="InstallButton" Content="INSTALL / UPDATE" HorizontalAlignment="Right" MinWidth="200" Click="Install" Background="#E7CC93" Foreground="#1C201A" FontWeight="SemiBold"/></Grid>
 </Grid>
</Window>

<Window x:Class="DovaInstaller.ModsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Your mods | Variant Mod Organizer" Width="960" Height="640" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#111310" Foreground="#F0F1E6" FontFamily="Segoe UI" FontSize="14">
<Grid Margin="26" Background="#111310"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="YOUR MODS" Foreground="#E7CC93" FontSize="12"/><TextBlock Text="Pick your loadout." FontSize="28" Margin="0,5,0,8"/><TextBlock Text="Use the arrows or drag mods across. Disabled means parked, not deleted." Foreground="#BCAE91" TextWrapping="Wrap"/></StackPanel>
<Grid Grid.Row="1" Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Search mods" Foreground="#BCAE91" FontSize="12"/><TextBox x:Name="SearchBox" TextChanged="FilterChanged" Padding="10,7" Background="#1C201A" Foreground="#F0F1E6" BorderBrush="#393B33"/></StackPanel><Button x:Name="ScanButton" Grid.Column="1" Content="Scan again" Click="Scan" Margin="12,15,0,0" Padding="14,7"/><Button x:Name="ImportButton" Grid.Column="2" Content="Import mod" Click="Import" Margin="8,15,0,0" Padding="14,7"/></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
<DockPanel><TextBlock x:Name="InactiveTitle" DockPanel.Dock="Top" Text="DISABLED" Foreground="#BCAE91" Margin="0,0,0,10"/><ListBox x:Name="InactiveList" Style="{StaticResource ModListStyle}" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" AllowDrop="True" DragOver="DragOverList" Drop="DropList"/></DockPanel>
<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10"><Button x:Name="EnableButton" Content="→" FontSize="25" ToolTip="Enable selected mods" Click="EnableMods" Padding="8" Margin="0,0,0,12"/><Button x:Name="DisableButton" Content="←" FontSize="25" ToolTip="Disable selected mods" Click="DisableMods" Padding="8"/></StackPanel>
<DockPanel Grid.Column="2"><TextBlock x:Name="ActiveTitle" DockPanel.Dock="Top" Text="ENABLED" Foreground="#E7CC93" Margin="0,0,0,10"/><ListBox x:Name="ModList" Style="{StaticResource ModListStyle}" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" AllowDrop="True" DragOver="DragOverList" Drop="DropList"/></DockPanel></Grid>
<StackPanel Grid.Row="3" Margin="0,14,0,14"><ProgressBar x:Name="WorkProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="#E7CC93" Margin="0,0,0,10"/><TextBlock x:Name="Message" Text="Enabled mods load when you launch modded. Close ICARUS before moving files." Foreground="#BCAE91" TextWrapping="Wrap"/></StackPanel>
<Grid Grid.Row="4"><StackPanel Orientation="Horizontal"><Button Content="Select all" Click="SelectAll" Padding="12,8"/><Button Content="Clear selection" Click="ClearSelection" Padding="12,8" Margin="8,0,0,0"/><Button x:Name="BackupButton" Content="Backups" Click="OpenBackup" Padding="12,8" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RemoveButton" Content="Remove selected" Click="Remove" Padding="12,8"/><Button x:Name="DoneButton" Content="Done" Click="Done" Background="#E7CC93" Foreground="#171A15" Padding="18,8" Margin="8,0,0,0"/></StackPanel></Grid></Grid></Window>
